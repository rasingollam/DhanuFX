// Luminar-3 - Pine Script port of the MT5 range EA (v3)
// Uses standard minute candles (M1-M60; M1 matches the EA exactly). Ranges are
// detected from the bar that crosses each configured NY time boundary.
// NY time is computed from the chart bar's NY hour/minute (DST handled automatically).
// NOTE: Pine time is in milliseconds; all window/length arithmetic uses ms.

//@version=6
indicator("Luminar-3", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

import TradingView/ta/12

// Colors are editable per group in the Inputs dialog. Bright chart-level
// defaults (midlines, volume/VA text, value-area fills) auto-adjust to the
// light/dark chart theme behind the scenes.

//===== Inputs =====
//--- Theme & Text ---
i_theme   = input.string("Auto", "Chart theme", options = ["Auto", "Dark", "Light"], group = "Theme & Text", tooltip = "Auto reads the chart background and adapts the chart-level colors. Dark/Light force a theme. Fixed colors and the Candle-1 VP / Info Display inputs are always respected.")
i_txDark  = input.color(#E6EDF7, "Default text (dark theme)", group = "Theme & Text", tooltip = "Main text/lines when the dark theme is active: range midlines, volume/VA labels, value-area fills.")
i_txLite  = input.color(#151A21,     "Default text (light theme)", group = "Theme & Text", tooltip = "Same default elements when the light theme is active.")
i_dimDark = input.color(#64748B,  "Dim (dark theme)", group = "Theme & Text", tooltip = "Secondary elements on dark: blend-in midlines and histogram bins.")
i_dimLite = input.color(#8A94A6,     "Dim (light theme)", group = "Theme & Text", tooltip = "Secondary elements on light.")
i_ctrDark = input.color(#F1F5F9, "Text on dark fills", group = "Theme & Text", tooltip = "On-fill labels (POC/VAH/VAL) when the bin color is dark.")
i_ctrLite = input.color(#111827,     "Text on bright fills", group = "Theme & Text", tooltip = "On-fill labels (POC/VAH/VAL) when the bin color is bright.")

//--- Ranges ---
i_r1s  = input.string("09:00",  "R1 start (NY, HH:mm)", group = "Ranges")
i_r1m  = input.int(90,          "R1 length (minutes)", minval = 1, maxval = 1440, group = "Ranges")
i_r1i  = input.string("09:30",  "R1 inside start (NY, HH:mm)", group = "Ranges")
i_r1im = input.int(15,          "R1 inside length (minutes)", minval = 1, maxval = 1440, group = "Ranges")

i_r2s  = input.string("03:00",  "R2 start (NY, HH:mm)", group = "Ranges")
i_r2m  = input.int(90,          "R2 length (minutes)", minval = 1, maxval = 1440, group = "Ranges")
i_r2i  = input.string("03:00",  "R2 inside start (NY, HH:mm)", group = "Ranges")
i_r2im = input.int(15,          "R2 inside length (minutes)", minval = 1, maxval = 1440, group = "Ranges")

i_r3s  = input.string("21:00",  "R3 start (NY, HH:mm)", group = "Ranges")
i_r3m  = input.int(90,          "R3 length (minutes)", minval = 1, maxval = 1440, group = "Ranges")
i_r3i  = input.string("21:00",  "R3 inside start (NY, HH:mm)", group = "Ranges")
i_r3im = input.int(15,          "R3 inside length (minutes)", minval = 1, maxval = 1440, group = "Ranges")

i_showR1 = input.bool(true,     "Show Range 1", group = "Ranges", tooltip = "Range 1 boxes plus high/low/mid lines.")
i_showR2 = input.bool(true,     "Show Range 2", group = "Ranges", tooltip = "Range 2 boxes plus high/low/mid lines.")
i_showR3 = input.bool(true,     "Show Range 3", group = "Ranges", tooltip = "Range 3 boxes plus high/low/mid lines.")
i_showInside = input.bool(true, "Show inside ranges", group = "Ranges", tooltip = "Inside-range boxes and their high/mid/low lines. Hidden when the parent Range 1/2/3 is switched off.")

i_opac = input.int(80,          "Box transparency (%)", minval = 0, maxval = 100, group = "Ranges")
i_bxW  = input.int(2,           "Range box border (px)", minval = 0, maxval = 10, group = "Ranges")
i_hlW  = input.int(2,           "High/low line thickness (px)", minval = 1, maxval = 10, group = "Ranges")
i_hlS  = input.string("solid",  "High/low line style", options = ["solid", "dotted", "dashed"], group = "Ranges")
i_midW = input.int(2,           "Midline thickness (px)", minval = 1, maxval = 10, group = "Ranges")
i_midS = input.string("dotted", "Midline style", options = ["solid", "dotted", "dashed"], group = "Ranges")

c_r1     = input.color(#3B82F6, "R1 color", group = "Ranges", inline = "rColors")
c_r2     = input.color(#DFA93F, "R2 color", group = "Ranges", inline = "rColors")
c_r3     = input.color(#3FCB6E, "R3 color", group = "Ranges", inline = "rColors")
c_inside = input.color(#8B5CF6, "Inside box color", group = "Ranges")
c_mid1   = input.color(#E9EFF7, "Range midpoint color", group = "Ranges")
c_mid2   = input.color(#F59E5B, "Inside midpoint color", group = "Ranges")

//--- Volume & Delta ---
i_showRPV = input.bool(true,  "Show range volume profile (PV)", group = "Volume & Delta", tooltip = "Per-range volume histogram with bin values and POC/VAH/VAL labels.")
i_binTxt  = input.bool(true,  "Show bin volume values", group = "Volume & Delta")
i_vplvls  = input.int(20,     "Price bins", minval = 2, maxval = 100, group = "Volume & Delta", tooltip = "Shared by range histograms and previous-session levels. Volume is distributed uniformly across each bar's high-low span.")
i_vapct   = input.int(70,     "Value area volume (%)", minval = 1, maxval = 100, group = "Volume & Delta")
i_delta   = input.bool(true,  "Show estimated delta", group = "Volume & Delta", tooltip = "Delta = estimated buy minus sell volume from candle direction; not exchange bid/ask order-flow. Excluded when a range has no volume.")
i_vpw     = input.int(60,     "Histogram width (minutes)", minval = 5, maxval = 240, group = "Volume & Delta")
i_vpgap   = input.int(10,     "Gap from range to histogram (minutes)", minval = 0, maxval = 120, group = "Volume & Delta")
i_txtGap  = input.int(8,      "Bin text left offset (minutes)", minval = 0, maxval = 120, group = "Volume & Delta")
i_txtCw   = input.float(1.4,  "Text spacing (minutes/digit)", minval = 0.1, maxval = 10, step = 0.1, group = "Volume & Delta")

i_vptxt = input.color(#DCE7F5, "Volume text color", group = "Volume & Delta")
i_vac   = input.color(#DCE7F5, "Value area / VAH / VAL labels", group = "Volume & Delta")
i_pocc  = input.color(#F2B237, "POC / boundary bins", group = "Volume & Delta")
c_dpos  = input.color(#22C55E, "Positive delta color", group = "Volume & Delta", inline = "deltaColors")
c_dneg  = input.color(#F43F5E, "Negative delta color", group = "Volume & Delta", inline = "deltaColors")

//--- Session ---
i_divOn   = input.bool(true,    "Show daily divider line", group = "Session")
i_divTime = input.string("18:00", "Session boundary (NY, HH:mm)", group = "Session", tooltip = "Levels use the preceding fixed 24 hours. New York clock changes are handled by the timezone; the lookback is always 24 elapsed hours.")
i_sessLvl = input.bool(true,    "Show previous-session VAH/VAL/POC", group = "Session")
i_szLvl   = input.string("normal", "VAH/VAL/POC label size", options = ["tiny", "small", "normal", "large", "huge"], group = "Session")
i_szW     = input.int(2,        "VAH/VAL/POC line thickness (px)", minval = 1, maxval = 10, group = "Session")
i_szS     = input.string("dashed", "VAH/VAL/POC line style", options = ["solid", "dotted", "dashed"], group = "Session")

c_div  = input.color(#64748B, "Divider color", group = "Session")
i_pval = input.color(#22D3EE, "VAL", group = "Session", inline = "sessColors")
i_pvah = input.color(#C084FC, "VAH", group = "Session", inline = "sessColors")
i_ppoc = input.color(#F97316, "POC", group = "Session", inline = "sessColors")

//--- HTF & LTF Candles ---
i_panel     = input.bool(true,    "Show HTF candle overlay", group = "HTF & LTF Candles", tooltip = "Draws the forming N-minute candle (90 by default) plus the last X closed ones directly on the chart at real prices, like a Power of Three HTF overlay.")
i_ptf       = input.int(90,       "Candle timeframe (minutes)", minval = 1, maxval = 1440, group = "HTF & LTF Candles")
i_htfAnchor = input.string("01:30", "Candle open time (NY, HH:mm)", group = "HTF & LTF Candles", tooltip = "Anchors the i_ptf-minute candle grid so one candle opens exactly at this NY time. Default 01:30 = the 01:30->03:00 candle whose open you were comparing.")
i_pprev     = input.int(2,        "Previous candles shown", minval = 0, maxval = 20, group = "HTF & LTF Candles")
i_htgap     = input.int(20,       "Gap from chart to HTF candles (bars)", minval = 1, maxval = 100, group = "HTF & LTF Candles", tooltip = "Horizontal distance from the current chart candle to the first HTF candle section, measured in chart-timeframe bars.")
i_pfill     = input.int(30,       "Body fill transparency (%)", minval = 0, maxval = 90, group = "HTF & LTF Candles")

i_pup = input.color(#22C55E, "Up candles", group = "HTF & LTF Candles", inline = "htfColors")
i_pdn = input.color(#F43F5E, "Down candles", group = "HTF & LTF Candles", inline = "htfColors")

i_lpanel  = input.bool(true,    "Show LTF candle overlay", group = "HTF & LTF Candles", tooltip = "Plots a compact lower-timeframe candle cluster (current + N previous) immediately right of the HTF candles, giving intra-candle context.")
i_ltf     = input.int(15,       "Lower timeframe (minutes)", minval = 1, maxval = 1440, group = "HTF & LTF Candles")
i_ltprev  = input.int(2,        "Previous LTF candles shown", minval = 0, maxval = 10, group = "HTF & LTF Candles")
i_ltgap   = input.int(1,        "Gap from HTF to LTF candles (slots)", minval = 0, maxval = 20, group = "HTF & LTF Candles", tooltip = "Empty candle-width slots between the HTF section and the LTF section.")

//--- Candle-1 VP ---
i_vph   = input.bool(true,    "Show candle-1 VP histogram", group = "Candle-1 VP", tooltip = "Volume profile of candle[1] (the last closed HTF candle), drawn immediately right of it. POC / VAH / VAL bins are highlighted.")
i_vphw  = input.int(30,       "VP histogram width (minutes)", minval = 2, maxval = 120, group = "Candle-1 VP", tooltip = "Width of the candle-1 volume-profile band in floor-time minutes on the x-axis.")
i_vpPoc = input.color(#F97316, "POC color", group = "Candle-1 VP", tooltip = "POC bin fill and its label.")
i_vpVal = input.color(#22D3EE, "VAL color", group = "Candle-1 VP", tooltip = "Lower value-area edge bin fill and its label.")
i_vpVah = input.color(#C084FC, "VAH color", group = "Candle-1 VP", tooltip = "Upper value-area edge bin fill and its label.")
i_vpVa  = input.color(#D9E6F7, "Value-area fill", group = "Candle-1 VP", tooltip = "Fill of the bins inside the value area (VAH to VAL).")
i_vpBin = input.color(#64748B, "Other bins", group = "Candle-1 VP", tooltip = "Fill of the bins outside the value area.")

//--- CVD ---
i_showCvd   = input.bool(true, "Show CVD panel", group = "CVD", tooltip = "Cumulative Volume Delta panel (bottom-left), same engine as TradingView's built-in CVD.")
i_cvdAnchor = input.timeframe("1W", "Anchor period", group = "CVD")
i_cvdAgg    = input.string("Time", "Data aggregation", options = ["Time", "1 tick"], group = "CVD", tooltip = "Defines how lower timeframe data is aggregated for the delta calculation. \"1 tick\" computes the delta on tick data and is available only on expert plans.")
i_cvdCustom = input.bool(false, "Use custom timeframe", group = "CVD", tooltip = "Override the automatic lower timeframe used to approximate up/down volume. Higher timeframes provide more historical data, but the data will be less precise.", active = i_cvdAgg != "1 tick")
i_cvdTf     = input.timeframe("1", "Timeframe", group = "CVD", active = i_cvdCustom and i_cvdAgg != "1 tick")
i_cvdDiv    = input.bool(true, "Show price-CVD divergence", group = "CVD", tooltip = "Price-CVD divergence between pivot highs/lows, drawn on the price chart. Pivot-confirmed, so a fresh signal can repaint until the pivot confirms.")
i_cvdDivMode = input.string("Both", "Divergence type", options = ["Regular", "Hidden", "Both"], group = "CVD", tooltip = "Regular: price and CVD disagree (reversal). Hidden: price makes a higher low / lower high while CVD makes a lower low / higher high (trend continuation).")
i_cvdDivL   = input.int(5, "Pivot left bars", minval = 1, maxval = 50, group = "CVD")
i_cvdDivR   = input.int(3, "Pivot right bars", minval = 1, maxval = 50, group = "CVD")
i_cvdDivMax = input.int(20, "Max divergence length (bars)", minval = 10, maxval = 1000, group = "CVD", tooltip = "Only near-term divergences: pivots older than this are dropped, so long-spanning divergences never signal.")
i_cvdPiv    = input.bool(false, "Show swing high/low markers", group = "CVD", tooltip = "Triangle markers on the exact swing highs/lows the divergence engine uses. Markers confirm late with the pivots.")

//--- Info Display ---
i_showTbl = input.bool(true,   "Show info tables", group = "Info Display", tooltip = "Top-right table with live HTF/LTF candle volume, buy/sell/delta and the HTF/LTF/range countdowns.")
i_tblBg   = input.color(#10151B,  "Table background (dark theme)", group = "Info Display", tooltip = "Background of the VP data table (top-right) and the countdown table (bottom-right) on dark charts.")
i_tblLb   = input.color(#9DA9BA, "Label text color (dark theme)", group = "Info Display", tooltip = "Captions such as Volume, Buy, Delta, '0m close' on dark charts.")
i_tblVl   = input.color(#E6EDF7,  "Value text color (dark theme)", group = "Info Display", tooltip = "Volume, delta, high/low and countdown values on dark charts.")
i_tblAcc  = input.color(#3B82F6,       "Accent color (dark theme)", group = "Info Display", tooltip = "Header cells, the countdown value cells and the table border on dark charts.")
i_tblBgL  = input.color(#F7FAFE,  "Light-theme background", group = "Info Display", tooltip = "Replaces the table background on light charts so the tables match the page.")
i_tblLbL  = input.color(#64748B, "Light-theme label color", group = "Info Display", tooltip = "Captions (Volume, Buy, Delta, '0m close') on light charts.")
i_tblVlL  = input.color(#151A21,  "Light-theme value color", group = "Info Display", tooltip = "Volume/delta/countdown values on light charts.")
i_tblAccL = input.color(#94A3B8,       "Light-theme accent color", group = "Info Display", tooltip = "Header cells, countdown values and border on light charts. Neutral by default.")
i_tblOp   = input.int(60,              "Table opacity (%)", minval = 10, maxval = 90, group = "Info Display", tooltip = "Opacity of the table background and the label/value cells.")
i_tblAOp  = input.int(40,              "Accent opacity (%)", minval = 5, maxval = 90, group = "Info Display", tooltip = "Opacity of the header/access cells and the border.")

//--- General ---
i_showPrev = input.bool(true,   "Show historical drawings", group = "General", tooltip = "ON keeps all drawings. OFF keeps only drawings from the current period onward (at/after the current session-start divider); older drawings are removed at each new session boundary. Object limits can also trim the oldest drawings.")

//------------ helpers ------------
// Standard helpers
f_lstyle(s) =>
    s == "dotted" ? line.style_dotted : s == "dashed" ? line.style_dashed : line.style_solid

f_lsize(s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : s == "normal" ? size.normal : s == "large" ? size.large : size.huge

f_parse(s) =>
    p = str.split(s, ":")
    ok = array.size(p) == 2 and str.length(s) == 5
    if ok
        ok := str.length(array.get(p, 0)) == 2 and str.length(array.get(p, 1)) == 2
    h = ok ? str.tonumber(array.get(p, 0)) : na
    m = ok ? str.tonumber(array.get(p, 1)) : na
    if na(h) or na(m)
        runtime.error("Invalid NY time '" + s + "'. Use HH:mm, for example 09:30.")
    if h < 0 or h > 23 or m < 0 or m > 59 or h != math.floor(h) or m != math.floor(m)
        runtime.error("Invalid NY time '" + s + "'. Hours must be 00-23 and minutes 00-59.")
    [int(h), int(m)]

// Circular clock intervals: touching endpoints are allowed; overlapping main
// windows are not supported by this renderer's single active-range state.
f_overlap(a, aLen, b, bLen) =>
    (b - a + 1440) % 1440 < aLen or (a - b + 1440) % 1440 < bLen

// Shared range/session volume allocation. A flat candle belongs to exactly one
// bin (including the uppermost price); missing volume contributes nothing.
f_addVolume(vols, base, step, h, l, v) =>
    if not na(v) and v > 0 and h >= l and step > 0
        levels = array.size(vols)
        if h == l
            q = math.max(0, math.min(levels - 1, int(math.floor((l - base) / step))))
            array.set(vols, q, array.get(vols, q) + v)
        else
            for q = 0 to levels - 1
                blo = base + q * step
                bhi = base + (q + 1) * step
                overlap = math.min(h, bhi) - math.max(l, blo)
                if overlap > 0
                    array.set(vols, q, array.get(vols, q) + v * overlap / (h - l))
    vols

f_sessionStart(t, h, m) =>
    yy = year(t, "America/New_York")
    mm = month(t, "America/New_York")
    dd = dayofmonth(t, "America/New_York")
    boundary = timestamp("America/New_York", yy, mm, dd, h, m)
    t >= boundary ? boundary : timestamp("America/New_York", yy, mm, dd - 1, h, m)

// Next upcoming boundary (strictly after t) at hh:mm on t's NY date, else the next NY day.
f_sessionNext(t, h, m) =>
    yy = year(t, "America/New_York")
    mm = month(t, "America/New_York")
    dd = dayofmonth(t, "America/New_York")
    boundary = timestamp("America/New_York", yy, mm, dd, h, m)
    t < boundary ? boundary : timestamp("America/New_York", yy, mm, dd + 1, h, m)

// Boundary of *today* (in the bar's NY date) at hh:mm; used for start detection.
f_nyBoundary(t, h, m) =>
    timestamp("America/New_York", year(t, "America/New_York"), month(t, "America/New_York"), dayofmonth(t, "America/New_York"), h, m)

// True on the first bar at/after a boundary when the previous bar was before it.
f_crossed(prevT, curT, boundary) =>
    not na(prevT) and prevT < boundary and curT >= boundary

f_arrMax(a) =>
    float m = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if na(m) or v > m
                m := v
    m

f_arrMin(a) =>
    float m = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if na(m) or v < m
                m := v
    m

// label size auto-selected from how many chart bars fit across the range
// (doubled step: tiny->small, small->normal, normal->large)
f_barSize(rw_bars) =>
    string s = size.small
    if rw_bars >= 60
        s := size.large
    else if rw_bars >= 25
        s := size.normal
    else
        s := size.small
    s

// compact volume text: 1500 -> 1.5K, -2500000 -> -2.5M
f_cvol(v) =>
    a = math.abs(v)
    sg = v < 0 ? "-" : ""
    r = a >= 1000000 ? sg + str.tostring(a / 1000000, "#.#") + "M" : a >= 1000 ? sg + str.tostring(a / 1000, "#.#") + "K" : sg + str.tostring(int(math.round(a)))
    r

// format seconds as HH:MM:SS
f_cnt(sec) =>
    hh = int(math.max(0, sec) / 3600)
    mm = int(math.max(0, sec) % 3600 / 60)
    ss = int(math.max(0, sec)) % 60
    (hh < 10 ? "0" : "") + str.tostring(hh) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm) + ":" + (ss < 10 ? "0" : "") + str.tostring(ss)

//------------ chart theme detection (Auto / Dark / Light) ------------
// Perceived luminance of a color (0 = black, 1 = white).
f_luma(c) =>
    (0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c)) / 255.0

// Text color that contrasts with a given fill color (dark text on bright fills,
// white text on dark fills). Used for POC/VAH/VAL word labels sitting on their
// own colored bins so the text never matches the bin.
f_txtC(c) =>
    f_luma(c) >= 0.55 ? i_ctrLite : i_ctrDark

tDark = i_theme == "Dark"
     ? true
     : i_theme == "Light"
     ? false
     : (na(chart.bg_color) ? true : f_luma(chart.bg_color) < 0.5)

// Chart-level colors come from the editable Theme & Text palette. The
// bright-default guard below only kicks in when the user keeps a color bright
// enough to become invisible on a light background; user-chosen dark colors
// always pass through unchanged.
tBlendText = tDark ? i_txDark : i_txLite
tBlendDim  = tDark ? i_dimDark : i_dimLite
cMidEff    = tDark or f_luma(c_mid1) < 0.75 ? c_mid1 : tBlendDim
tVptxEff   = tDark or f_luma(i_vptxt) < 0.75 ? i_vptxt : tBlendText
tVacEff    = tDark or f_luma(i_vac) < 0.75 ? i_vac : tBlendText
// Candle-1 VP histogram: same bright-default guard so white/silver defaults
// stay visible on a light background while user-chosen dark colors pass through.
tVpPocEff  = tDark or f_luma(i_vpPoc) < 0.6 ? i_vpPoc : tBlendText
tVpValEff  = tDark or f_luma(i_vpVal) < 0.6 ? i_vpVal : tBlendText
tVpVahEff  = tDark or f_luma(i_vpVah) < 0.6 ? i_vpVah : tBlendText
tVpVaEff   = tDark or f_luma(i_vpVa) < 0.6 ? i_vpVa  : tBlendText
tVpBinEff  = tDark or f_luma(i_vpBin) < 0.6 ? i_vpBin : tBlendDim

//------------ FIFO garbage collection (deterministic, stays under the 500 hard cap) ------------
// Register each object so explicit deletion and budgets stay synchronized.
// Retention depends on bin count and label settings; it is not a fixed day count.
const int OCAP_BOX = 460
const int OCAP_LIN = 420
const int OCAP_LBL = 480
var array<box>   g_boxes  = array.new_box()
var array<line>  g_lines  = array.new_line()
var array<label> g_labels = array.new_label()

f_regBox(b) =>
    array.push(g_boxes, b)
    if array.size(g_boxes) > OCAP_BOX
        box.delete(array.get(g_boxes, 0))
        array.shift(g_boxes)
    b

f_regLine(l) =>
    array.push(g_lines, l)
    if array.size(g_lines) > OCAP_LIN
        line.delete(array.get(g_lines, 0))
        array.shift(g_lines)
    l

f_regLabel(t) =>
    array.push(g_labels, t)
    if array.size(g_labels) > OCAP_LBL
        label.delete(array.get(g_labels, 0))
        array.shift(g_labels)
    t

// Divergence drawings keep their own capped FIFO pools so range/session/bin
// churn can never evict them (keeps 1:1 parity with the CVD companion pane,
// which draws almost nothing else). Same purge semantics as the shared pools.
const int OCAP_DIV = 200
var array<line>  g_divL = array.new_line()
var array<label> g_divT = array.new_label()

f_regDivL(l) =>
    array.push(g_divL, l)
    if array.size(g_divL) > OCAP_DIV
        line.delete(array.get(g_divL, 0))
        array.shift(g_divL)
    l

f_regDivT(t) =>
    array.push(g_divT, t)
    if array.size(g_divT) > OCAP_DIV
        label.delete(array.get(g_divT, 0))
        array.shift(g_divT)
    t

// POC/VAH/VAL of the previous daily range for session S. Preferred window is
// [S-24 elapsed hours, S). If that window has no bars (e.g. a Monday after a
// closed weekend), step back one day at a time up to maxDays to use the most
// recent trading day instead.
// Returns [valPrice, vahPrice, pocPrice]; all na if no window has bars.
f_sessionPrices(S, maxDays = 4) =>
    float pVal = na
    float pVah = na
    float pPoc = na
    float ssHi = na
    float ssLo = na
    int wDays = 1
    while na(ssHi) and wDays <= maxDays
        wa = S - 86400000 * wDays
        wb = S - 86400000 * (wDays - 1)
        ssHi := na
        ssLo := na
        int qt = 1
        while qt <= 3000 and not na(time[qt]) and time[qt] >= wa
            if time[qt] < wb
                ssHi := na(ssHi) ? high[qt] : math.max(ssHi, high[qt])
                ssLo := na(ssLo) ? low[qt]  : math.min(ssLo, low[qt])
            qt += 1
        if not na(ssHi) and not na(ssLo) and ssHi > ssLo
            sLevels2 = math.max(2, i_vplvls)
            sStep2   = (ssHi - ssLo) / sLevels2
            sVols2   = array.new_float(sLevels2, 0.0)
            qt := 1
            while qt <= 3000 and not na(time[qt]) and time[qt] >= wa
                if time[qt] < wb
                    f_addVolume(sVols2, ssLo, sStep2, high[qt], low[qt], volume[qt])
                qt += 1
            sVmax2 = f_arrMax(sVols2)
            if not na(sVmax2) and sVmax2 > 0
                sTotal2 = 0.0
                for q = 0 to sLevels2 - 1
                    sTotal2 += array.get(sVols2, q)
                int sPoc2 = 0
                for q = 1 to sLevels2 - 1
                    if array.get(sVols2, q) > array.get(sVols2, sPoc2)
                        sPoc2 := q
                sVaLo2 = sPoc2
                sVaHi2 = sPoc2
                if sTotal2 > 0
                    sVarea2 = array.get(sVols2, sPoc2)
                    sTar2 = math.min(1.0, i_vapct / 100.0) * sTotal2
                    while sVarea2 < sTar2 and (sVaLo2 > 0 or sVaHi2 < sLevels2 - 1)
                        sAbove2 = sVaHi2 < sLevels2 - 1 ? array.get(sVols2, sVaHi2 + 1) : -1.0
                        sBelow2 = sVaLo2 > 0            ? array.get(sVols2, sVaLo2 - 1) : -1.0
                        if sAbove2 < 0
                            sVaLo2 -= 1
                            sVarea2 += array.get(sVols2, sVaLo2)
                        else if sBelow2 < 0
                            sVaHi2 += 1
                            sVarea2 += array.get(sVols2, sVaHi2)
                        else if sAbove2 >= sBelow2
                            sVaHi2 += 1
                            sVarea2 += array.get(sVols2, sVaHi2)
                        else
                            sVaLo2 -= 1
                            sVarea2 += array.get(sVols2, sVaLo2)
                pVal := ssLo + sVaLo2 * sStep2
                pVah := ssLo + (sVaHi2 + 1) * sStep2
                pPoc := ssLo + (sPoc2 + 0.5) * sStep2
        wDays += 1
    [pVal, pVah, pPoc]

// Volume bins over the historical window [tA, tB) (used for the candle-1
// histogram inside the HTF overlay). Fully closed window, so the profile is
// static until the candle-1 identity changes.
// Returns [volsPerBin, lo, step, vmax, pocBin, vaHiBin, vaLoBin].
f_candleProfile(tA, tB, levels) =>
    float cHi = na
    float cLo = na
    int qt = 1
    while qt <= 3000 and not na(time[qt]) and time[qt] >= tA
        if time[qt] < tB
            cHi := na(cHi) ? high[qt] : math.max(cHi, high[qt])
            cLo := na(cLo) ? low[qt] : math.min(cLo, low[qt])
        qt += 1
    array<float> cVols = array.new_float(levels, 0.0)
    float cStep = na
    if not na(cHi) and not na(cLo) and cHi > cLo
        cStep := (cHi - cLo) / levels
        int qt2 = 1
        while qt2 <= 3000 and not na(time[qt2]) and time[qt2] >= tA
            if time[qt2] < tB
                f_addVolume(cVols, cLo, cStep, high[qt2], low[qt2], volume[qt2])
            qt2 += 1
    float cVmax = f_arrMax(cVols)
    int cPoc = -1
    if not na(cVmax) and cVmax > 0
        int p0 = 0
        for q0 = 1 to levels - 1
            if array.get(cVols, q0) > array.get(cVols, p0)
                p0 := q0
        cPoc := p0
    int cVaHi = -1
    int cVaLo = -1
    if cPoc >= 0
        cTotal = 0.0
        for q0 = 0 to levels - 1
            cTotal += array.get(cVols, q0)
        cVaHi := cPoc
        cVaLo := cPoc
        if cTotal > 0
            cArea = array.get(cVols, cPoc)
            cTar = math.min(1.0, i_vapct / 100.0) * cTotal
            while cArea < cTar and (cVaLo > 0 or cVaHi < levels - 1)
                cAbove = cVaHi < levels - 1 ? array.get(cVols, cVaHi + 1) : -1.0
                cBelow = cVaLo > 0            ? array.get(cVols, cVaLo - 1) : -1.0
                if cAbove < 0
                    cVaLo -= 1
                    cArea += array.get(cVols, cVaLo)
                else if cBelow < 0
                    cVaHi += 1
                    cArea += array.get(cVols, cVaHi)
                else if cAbove >= cBelow
                    cVaHi += 1
                    cArea += array.get(cVols, cVaHi)
                else
                    cVaLo -= 1
                    cArea += array.get(cVols, cVaLo)
    [cVols, cLo, cStep, cVmax, cPoc, cVaHi, cVaLo]

// Draw one session's POC/VAH/VAL dotted lines + labels across [S, S+24h).
f_drawLevelLines(S, vv, ah, pp) =>
    if not na(vv) and not na(ah) and not na(pp)
        endT = S + 86400000
        f_regLine(line.new(S, vv, endT, vv, xloc.bar_time, color = i_pval, style = f_lstyle(i_szS), width = i_szW))
        f_regLabel(label.new(S, vv, "VAL", xloc = xloc.bar_time, color = na,
             textcolor = i_pval, style = label.style_none, size = f_lsize(i_szLvl)))
        f_regLabel(label.new(endT, vv, "VAL", xloc = xloc.bar_time, color = na,
             textcolor = i_pval, style = label.style_none, size = f_lsize(i_szLvl)))
        f_regLine(line.new(S, ah, endT, ah, xloc.bar_time, color = i_pvah, style = f_lstyle(i_szS), width = i_szW))
        f_regLabel(label.new(S, ah, "VAH", xloc = xloc.bar_time, color = na,
             textcolor = i_pvah, style = label.style_none, size = f_lsize(i_szLvl)))
        f_regLabel(label.new(endT, ah, "VAH", xloc = xloc.bar_time, color = na,
             textcolor = i_pvah, style = label.style_none, size = f_lsize(i_szLvl)))
        f_regLine(line.new(S, pp, endT, pp, xloc.bar_time, color = i_ppoc, style = f_lstyle(i_szS), width = i_szW))
        f_regLabel(label.new(S, pp, "POC", xloc = xloc.bar_time, color = na,
             textcolor = i_ppoc, style = label.style_none, size = f_lsize(i_szLvl)))
        f_regLabel(label.new(endT, pp, "POC", xloc = xloc.bar_time, color = na,
             textcolor = i_ppoc, style = label.style_none, size = f_lsize(i_szLvl)))

//------------ range configuration (parsed once) ------------
[rh1, rm1]   = f_parse(i_r1s)
[rih1, rim1] = f_parse(i_r1i)
[rh2, rm2]   = f_parse(i_r2s)
[rih2, rim2] = f_parse(i_r2i)
[rh3, rm3]   = f_parse(i_r3s)
[rih3, rim3] = f_parse(i_r3i)
[divh, divm] = f_parse(i_divTime)

if barstate.isfirst
    if not chart.is_standard or not timeframe.isminutes or timeframe.multiplier < 1 or timeframe.multiplier > 60
        runtime.error("Luminar-3 works on standard minute charts from M1 to M60. Use M1 for the exact range/session windows of the MT5 EA.")
    mainStarts = array.from(rh1 * 60 + rm1, rh2 * 60 + rm2, rh3 * 60 + rm3)
    insideStarts = array.from(rih1 * 60 + rim1, rih2 * 60 + rim2, rih3 * 60 + rim3)
    mainLengths = array.from(i_r1m, i_r2m, i_r3m)
    insideLengths = array.from(i_r1im, i_r2im, i_r3im)
    for k = 0 to 2
        insideOffset = (array.get(insideStarts, k) - array.get(mainStarts, k) + 1440) % 1440
        if insideOffset + array.get(insideLengths, k) > array.get(mainLengths, k)
            runtime.error("Inside range " + str.tostring(k + 1) + " must fit within its main range.")
    for a = 0 to 1
        for b = a + 1 to 2
            if f_overlap(array.get(mainStarts, a), array.get(mainLengths, a), array.get(mainStarts, b), array.get(mainLengths, b))
                runtime.error("Main ranges " + str.tostring(a + 1) + " and " + str.tostring(b + 1) + " overlap. Use non-overlapping windows.")

//------------ per-bar NY date (used for today's ranges) ------------
nMain = array.from(i_r1m, i_r2m, i_r3m)
nIn   = array.from(i_r1im, i_r2im, i_r3im)
cMain = array.from(c_r1, c_r2, c_r3)

//------------ state ------------
var int     g_mainRs  = na
var int     g_mRe     = na
var int     g_mainIdx = -1
var array<float> g_mH = array.new_float()
var array<float> g_mL = array.new_float()
var array<float> g_mO = array.new_float()
var array<float> g_mC = array.new_float()
var array<float> g_mV = array.new_float()

var int     g_inRs      = na
var int     g_inRe      = na
var int     g_inIdx     = -1
var int     g_inMainRs  = na
var int     g_inMainRe  = na
var int     g_inLineEnd = na
var array<int>  g_lastRs = array.new_int(3, na)
var array<float> g_iH = array.new_float()
var array<float> g_iL = array.new_float()
var array<float> g_iV = array.new_float()

bt        = time             // current bar open (ms), the window anchor when a boundary is crossed
curSessionStart = f_sessionStart(last_bar_time, divh, divm)
sessionStart = f_sessionStart(bt, divh, divm)
newSession = not na(sessionStart[1]) and sessionStart != sessionStart[1]

// In current-period-only mode, discard earlier periods' objects at each session
// boundary. The current period's objects (divider, levels, ranges) are created
// AFTER this purge on that bar, so everything from the current start divider
// onward stays visible.
if not i_showPrev and newSession
    while array.size(g_boxes) > 0
        box.delete(array.shift(g_boxes))
    while array.size(g_lines) > 0
        line.delete(array.shift(g_lines))
    while array.size(g_labels) > 0
        label.delete(array.shift(g_labels))
    while array.size(g_divL) > 0
        line.delete(array.shift(g_divL))
    while array.size(g_divT) > 0
        label.delete(array.shift(g_divT))

//---- which range starts on this bar (crosses its NY-time boundary) ----
rS = array.from(f_nyBoundary(bt, rh1, rm1), f_nyBoundary(bt, rh2, rm2), f_nyBoundary(bt, rh3, rm3))
rIS = array.from(f_nyBoundary(bt, rih1, rim1), f_nyBoundary(bt, rih2, rim2), f_nyBoundary(bt, rih3, rim3))
int foundM = -1
for k = 0 to 2
    if f_crossed(time[1], time, array.get(rS, k)) and time < array.get(rS, k) + array.get(nMain, k) * 60000
        foundM := k
int foundI = -1
for k = 0 to 2
    if f_crossed(time[1], time, array.get(rIS, k)) and time < array.get(rIS, k) + array.get(nIn, k) * 60000
        foundI := k

//=== 1) MAIN COMPLETION (window ended on/after this bar) ==============
if not na(g_mRe) and not na(g_mainRs) and g_mainIdx >= 0 and bt >= g_mRe
    k = g_mainIdx
    rs = g_mainRs
    re = g_mRe
    hi = f_arrMax(g_mH)
    lo = f_arrMin(g_mL)
    if not na(hi) and hi > lo and (i_showPrev or rs >= curSessionStart)
        color col   = array.get(cMain, k)
        mins    = array.get(nMain, k)
        lineEnd = rs + 4 * mins * 60000
        rgOn = k == 0 ? i_showR1 : k == 1 ? i_showR2 : i_showR3
        if rgOn
            // box
            f_regBox(box.new(rs, hi, re, lo, xloc = xloc.bar_time,
                 border_color = col, bgcolor = color.new(col, i_opac), border_width = i_bxW))
            // solid high/low + dotted mid lines
            f_regLine(line.new(re, hi, lineEnd, hi, xloc.bar_time, color = col, style = f_lstyle(i_hlS), width = i_hlW))
            f_regLine(line.new(re, lo, lineEnd, lo, xloc.bar_time, color = col, style = f_lstyle(i_hlS), width = i_hlW))
            f_regLine(line.new(re, (hi + lo) / 2, lineEnd, (hi + lo) / 2, xloc.bar_time,
                 color = cMidEff, style = f_lstyle(i_midS), width = i_midW))
        // ---- volume profile (overlap-weighted bins) ----
        levels = math.max(2, i_vplvls)
        step   = (hi - lo) / levels
        vols   = array.new_float(levels, 0.0)
        for b = 0 to array.size(g_mH) - 1
            h1 = array.get(g_mH, b)
            l1 = array.get(g_mL, b)
            v1 = array.get(g_mV, b)
            f_addVolume(vols, lo, step, h1, l1, v1)
        vmax = f_arrMax(vols)
        if i_showRPV and not na(vmax) and vmax > 0
            // POC + value area expansion
            total = 0.0
            for q = 0 to levels - 1
                total += array.get(vols, q)
            int poc = 0
            for q = 1 to levels - 1
                if array.get(vols, q) > array.get(vols, poc)
                    poc := q
            va_lo = poc
            va_hi = poc
            if total > 0
                varea = array.get(vols, poc)
                tar = math.min(1.0, i_vapct / 100.0) * total
                while varea < tar and (va_lo > 0 or va_hi < levels - 1)
                    above = va_hi < levels - 1 ? array.get(vols, va_hi + 1) : -1.0
                    below = va_lo > 0         ? array.get(vols, va_lo - 1) : -1.0
                    if above < 0
                        va_lo -= 1
                        varea += array.get(vols, va_lo)
                    else if below < 0
                        va_hi += 1
                        varea += array.get(vols, va_hi)
                    else if above >= below
                        va_hi += 1
                        varea += array.get(vols, va_hi)
                    else
                        va_lo -= 1
                        varea += array.get(vols, va_lo)
            // draw bins (colored) + per-bin volume values
            for q = 0 to levels - 1
                vq = array.get(vols, q)
                if vq > 0
                    wq = int(math.max(1.0, math.round(60000.0 * i_vpw * vq / vmax)))
                    t1 = rs - int(i_vpgap * 60000) - wq
                    blo = lo + q * step
                    bhi = lo + (q + 1) * step
                    bclr = (q == poc or q == va_lo or q == va_hi)
                         ? color.new(i_pocc, 35)
                         : (q >= va_lo and q <= va_hi ? color.new(tVacEff, 35) : color.new(col, i_opac))
                    f_regBox(box.new(t1, bhi, int(rs - int(i_vpgap * 60000)), blo, xloc = xloc.bar_time,
                         border_color = bclr, bgcolor = bclr, border_width = 1))
                    if i_binTxt
                        tv = str.tostring(int(math.round(vq)))
                        f_regLabel(label.new(int(t1 - i_txtGap * 60000 - str.length(tv) * i_txtCw * 60000 / 2),
                             (blo + bhi) / 2 - step * 0.2, tv,
                             xloc = xloc.bar_time, color = na, textcolor = tVptxEff,
                             style = label.style_none, size = size.small))
                    // POC / VAH / VAL word labels centered inside their own bin
                    if q == poc
                        f_regLabel(label.new(int(rs - int(i_vpgap * 60000) - wq / 2), (blo + bhi) / 2 - step * 0.4, "POC",
                             xloc = xloc.bar_time, color = na, textcolor = f_txtC(i_pocc),
                             style = label.style_none, size = size.small))
                    if q == va_hi
                        f_regLabel(label.new(int(rs - int(i_vpgap * 60000) - wq / 2), (blo + bhi) / 2 - step * 0.4, "VAH",
                             xloc = xloc.bar_time, color = na, textcolor = f_txtC(tVacEff),
                             style = label.style_none, size = size.small))
                    if q == va_lo
                        f_regLabel(label.new(int(rs - int(i_vpgap * 60000) - wq / 2), (blo + bhi) / 2 - step * 0.4, "VAL",
                             xloc = xloc.bar_time, color = na, textcolor = f_txtC(tVacEff),
                             style = label.style_none, size = size.small))
// ---- delta spread across the range top ----
        if i_delta and array.sum(g_mV) > 0
            buys = 0.0
            sells = 0.0
            for b = 0 to array.size(g_mO) - 1
                o = array.get(g_mO, b)
                c = array.get(g_mC, b)
                v = array.get(g_mV, b)
                if c > o
                    buys += v
                else if c < o
                    sells += v
                else
                    buys += v / 2
                    sells += v / 2
            diff = buys - sells
            ybs = hi + (hi - lo) * 0.03
            rwb = (re - rs) / nz(time - time[1], 60000)
            s3 = "Δ " + str.tostring(int(math.round(math.abs(diff))))
            f_regLabel(label.new(int(rs + (re - rs) / 2), ybs, s3, xloc = xloc.bar_time, color = na,
                 textcolor = diff >= 0 ? c_dpos : c_dneg,
                 style = label.style_none, size = f_barSize(rwb)))
    // reset state
    g_mainRs  := na
    g_mRe     := na
    g_mainIdx := -1
    array.clear(g_mH)
    array.clear(g_mL)
    array.clear(g_mO)
    array.clear(g_mC)
    array.clear(g_mV)

//=== 2) INSIDE COMPLETION (independent of main range) =================
if not na(g_inRe) and not na(g_inRs) and g_inIdx >= 0 and bt >= g_inRe
    rsI = g_inRs
    reI = g_inRe
    giM = not na(g_inMainRs) and g_inMainRs <= rsI and reI <= g_inMainRe
    hiI = f_arrMax(g_iH)
    loI = f_arrMin(g_iL)
    if not na(hiI) and hiI > loI and giM and (i_showPrev or rsI >= curSessionStart)
        leI = na(g_inLineEnd) ? reI + 3 * array.get(nIn, g_inIdx) * 60000 : g_inLineEnd
        rgOnI = g_inIdx == 0 ? i_showR1 : g_inIdx == 1 ? i_showR2 : i_showR3
        if i_showInside and rgOnI
            f_regBox(box.new(rsI, hiI, reI, loI, xloc = xloc.bar_time,
                 border_color = c_inside, bgcolor = color.new(c_inside, i_opac), border_width = i_bxW))
            f_regLine(line.new(reI, hiI, leI, hiI, xloc.bar_time, color = c_inside, style = f_lstyle(i_hlS), width = i_hlW))
            f_regLine(line.new(reI, (hiI + loI) / 2, leI, (hiI + loI) / 2, xloc.bar_time,
                 color = c_mid2, style = f_lstyle(i_midS), width = i_midW))
            f_regLine(line.new(reI, loI, leI, loI, xloc.bar_time, color = c_inside, style = f_lstyle(i_hlS), width = i_hlW))
    g_inRs      := na
    g_inRe      := na
    g_inIdx     := -1
    g_inLineEnd := na
    array.clear(g_iH)
    array.clear(g_iL)
    array.clear(g_iV)

//=== 2b) DAILY DIVIDER (full-window vertical line at the NY divider time) =
// The defined segment sits between this bar's high/low, i.e. inside the data
// range, so it never distends the autoscaled price range; extend.both then
// stretches the vertical line to the top and bottom edges of the pane.
if i_divOn and newSession and (i_showPrev or sessionStart == curSessionStart)
    divLn = line.new(sessionStart, low, sessionStart, math.max(high, low + syminfo.mintick), xloc.bar_time, color = c_div, style = line.style_dashed)
    line.set_extend(divLn, extend.both)
    f_regLine(divLn)

//=== 2b2) UPCOMING DIVIDER (next NY session boundary, drawn in advance) =
// Draw a dashed line at the NEXT NY divider time so the current day's
// upcoming boundary is visible even before it it reached. Re-pinned each bar.
var line g_fDiv = na
if i_divOn
    nextSession = f_sessionNext(last_bar_time, divh, divm)
    if na(g_fDiv)
        g_fDiv := line.new(nextSession, low, nextSession, math.max(high, low + syminfo.mintick), xloc = xloc.bar_time, color = c_div, style = line.style_dashed)
        line.set_extend(g_fDiv, extend.both)
    else
        line.set_x1(g_fDiv, nextSession)
        line.set_x2(g_fDiv, nextSession)
else
    if not na(g_fDiv)
        line.delete(g_fDiv)
        g_fDiv := na

//=== 2c) PREV SESSION (18:00->18:00) VOLUME PROFILE LEVELS ============
// For each session S (a crossed 18:00 divider), take ONLY the previous
// daily range [S-24 elapsed hours, S) - the prior divider to this divider -
// and draw its POC/VAH/VAL across the current period [S, S+24h).
// Historical sessions draw once per session (i_showPrev). The CURRENT period
// gets a dedicated set of persistent objects refreshed whenever the latest
// divider moves, so levels never depend on replay timing or FIFO eviction.
var int g_l4S = na
l4New = na(g_l4S) or sessionStart != g_l4S
if i_sessLvl and not na(sessionStart) and l4New and i_showPrev
    g_l4S := sessionStart
    [sv, sah, sp] = f_sessionPrices(sessionStart)
    f_drawLevelLines(sessionStart, sv, sah, sp)

var int   g_lCur = na
var line  cValL = na
var line  cVahL = na
var line  cPocL = na
var label cValS = na
var label cValE = na
var label cVahS = na
var label cVahE = na
var label cPocS = na
var label cPocE = na
var float cVal = na
var float cVah = na
var float cPoc = na

// This is the completed prior session's profile projected across the active
// session. Calculate it during the historical pass as soon as execution enters
// the active session. At that point the source window is directly behind the
// current bar, avoiding a near-3000-bar scan from the last bar on M1 charts.
// A failed calculation leaves g_lCur unchanged, so each following bar retries.
if i_sessLvl and not na(curSessionStart) and sessionStart == curSessionStart and (na(g_lCur) or curSessionStart != g_lCur)
    [cv, cvah, cpoc] = f_sessionPrices(curSessionStart)
    if not na(cv) and not na(cvah) and not na(cpoc)
        cVal := cv
        cVah := cvah
        cPoc := cpoc
        g_lCur := curSessionStart

// Render only on the last bar. These dedicated objects are never registered
// in, or deleted by, the i_showPrev purge arrays and are updated in place.
if i_sessLvl and barstate.islast and not na(curSessionStart)
    if g_lCur == curSessionStart and not na(cVal) and not na(cVah) and not na(cPoc)
        cE = f_sessionNext(curSessionStart, divh, divm)
        if na(cValL)
            cValL := line.new(curSessionStart, cVal, cE, cVal, xloc.bar_time, color = i_pval, style = f_lstyle(i_szS), width = i_szW)
            cValS := label.new(curSessionStart, cVal, "VAL", xloc = xloc.bar_time, color = na,
                 textcolor = i_pval, style = label.style_none, size = f_lsize(i_szLvl))
            cValE := label.new(cE, cVal, "VAL", xloc = xloc.bar_time, color = na,
                 textcolor = i_pval, style = label.style_none, size = f_lsize(i_szLvl))
            cVahL := line.new(curSessionStart, cVah, cE, cVah, xloc.bar_time, color = i_pvah, style = f_lstyle(i_szS), width = i_szW)
            cVahS := label.new(curSessionStart, cVah, "VAH", xloc = xloc.bar_time, color = na,
                 textcolor = i_pvah, style = label.style_none, size = f_lsize(i_szLvl))
            cVahE := label.new(cE, cVah, "VAH", xloc = xloc.bar_time, color = na,
                 textcolor = i_pvah, style = label.style_none, size = f_lsize(i_szLvl))
            cPocL := line.new(curSessionStart, cPoc, cE, cPoc, xloc.bar_time, color = i_ppoc, style = f_lstyle(i_szS), width = i_szW)
            cPocS := label.new(curSessionStart, cPoc, "POC", xloc = xloc.bar_time, color = na,
                 textcolor = i_ppoc, style = label.style_none, size = f_lsize(i_szLvl))
            cPocE := label.new(cE, cPoc, "POC", xloc = xloc.bar_time, color = na,
                 textcolor = i_ppoc, style = label.style_none, size = f_lsize(i_szLvl))
        else
            line.set_xy1(cValL, curSessionStart, cVal)
            line.set_xy2(cValL, cE, cVal)
            line.set_color(cValL, i_pval)
            line.set_style(cValL, f_lstyle(i_szS))
            line.set_width(cValL, i_szW)
            label.set_xy(cValS, curSessionStart, cVal)
            label.set_textcolor(cValS, i_pval)
            label.set_size(cValS, f_lsize(i_szLvl))
            label.set_xy(cValE, cE, cVal)
            label.set_textcolor(cValE, i_pval)
            label.set_size(cValE, f_lsize(i_szLvl))

            line.set_xy1(cVahL, curSessionStart, cVah)
            line.set_xy2(cVahL, cE, cVah)
            line.set_color(cVahL, i_pvah)
            line.set_style(cVahL, f_lstyle(i_szS))
            line.set_width(cVahL, i_szW)
            label.set_xy(cVahS, curSessionStart, cVah)
            label.set_textcolor(cVahS, i_pvah)
            label.set_size(cVahS, f_lsize(i_szLvl))
            label.set_xy(cVahE, cE, cVah)
            label.set_textcolor(cVahE, i_pvah)
            label.set_size(cVahE, f_lsize(i_szLvl))

            line.set_xy1(cPocL, curSessionStart, cPoc)
            line.set_xy2(cPocL, cE, cPoc)
            line.set_color(cPocL, i_ppoc)
            line.set_style(cPocL, f_lstyle(i_szS))
            line.set_width(cPocL, i_szW)
            label.set_xy(cPocS, curSessionStart, cPoc)
            label.set_textcolor(cPocS, i_ppoc)
            label.set_size(cPocS, f_lsize(i_szLvl))
            label.set_xy(cPocE, cE, cPoc)
            label.set_textcolor(cPocE, i_ppoc)
            label.set_size(cPocE, f_lsize(i_szLvl))
else if barstate.islast
    if not na(cValL)
        line.delete(cValL)
        cValL := na
    if not na(cVahL)
        line.delete(cVahL)
        cVahL := na
    if not na(cPocL)
        line.delete(cPocL)
        cPocL := na
    if not na(cValS)
        label.delete(cValS)
        cValS := na
    if not na(cValE)
        label.delete(cValE)
        cValE := na
    if not na(cVahS)
        label.delete(cVahS)
        cVahS := na
    if not na(cVahE)
        label.delete(cVahE)
        cVahE := na
    if not na(cPocS)
        label.delete(cPocS)
        cPocS := na
    if not na(cPocE)
        label.delete(cPocE)
        cPocE := na

//=== 3) STARTS =========================================================
int actM = -1
if not na(g_mRe)
    actM := g_mainIdx
else if foundM >= 0
    array.set(g_lastRs, foundM, array.get(rS, foundM))
    g_mainRs  := array.get(rS, foundM)
    g_mRe     := g_mainRs + array.get(nMain, foundM) * 60000
    g_mainIdx := foundM
    array.clear(g_mH)
    array.clear(g_mL)
    array.clear(g_mO)
    array.clear(g_mC)
    array.clear(g_mV)
    actM := foundM

int actI = -1
if not na(g_inRe)
    actI := g_inIdx
else if foundI >= 0
    g_inRs    := array.get(rIS, foundI)
    g_inRe    := g_inRs + array.get(nIn, foundI) * 60000
    g_inIdx   := foundI
    g_inMainRs:= array.get(g_lastRs, foundI)
    g_inMainRe:= na(g_inMainRs) ? na : g_inMainRs + array.get(nMain, foundI) * 60000
    g_inLineEnd:= na(g_inMainRs) ? na : g_inMainRs + 4 * array.get(nMain, foundI) * 60000
    array.clear(g_iH)
    array.clear(g_iL)
    array.clear(g_iV)
    actI := foundI

//=== 4) ACCUMULATE current bar into active windows ====================
if actM >= 0
    array.push(g_mH, high)
    array.push(g_mL, low)
    array.push(g_mO, open)
    array.push(g_mC, close)
    array.push(g_mV, nz(volume, 0.0))
if actI >= 0
    array.push(g_iH, high)
    array.push(g_iL, low)
    array.push(g_iV, nz(volume, 0.0))

//=== 5) HTF CANDLE OVERLAY (shifted into the future) ===================
// Aggregates chart bars into i_ptf-minute buckets. The forming candle
// and the last X closed ones are drawn as wick + body at real prices,
// anchored with xloc.bar_index (integer chart-bar offsets) so hidden
// exchange halts / session gaps can never swallow them: the block starts
// two candle-widths closer than 1 + X (never before the last bar),
// oldest left, forming right. Redrawn every bar (old objects deleted
// first, no trails).
bktMin = int(i_ptf)
bktSec = bktMin * 60000
// Bucket grid anchored at a user-selected NY open time (i_htfAnchor). The
// pattern repeats daily: boundaries at anchor, anchor+1*len, ... (mod 1440).
[ahA, amA] = f_parse(i_htfAnchor)
aMin = ahA * 60 + amA
nyMo = timestamp("America/New_York", year(bt, "America/New_York"), month(bt, "America/New_York"), dayofmonth(bt, "America/New_York"), 0, 0)
nMM = hour(bt, "America/New_York") * 60 + minute(bt, "America/New_York")
bStartMin = int((((nMM - aMin) + 1440) % 1440) / bktMin) * bktMin + aMin
if bStartMin > nMM
    bStartMin -= 1440
bkt = nyMo + bStartMin * 60000
var int   pBktId   = na
var float pBktO    = na
var float pBktH    = na
var float pBktL    = na
var float pBktC    = na
var float pBktB    = na
var float pBktS    = na
var float pBktDx   = na
var float pBktDn   = na
var array<float> pC  = array.new_float()
var array<int>   pCB = array.new_int()
var array<float> pV  = array.new_float()
var array<box>   pBoxes = array.new_box()
var array<line>  pWicks = array.new_line()

// persistent forming-candle objects (updated in-place every tick)
var box   fBox    = na
var line  fWickUp = na
var line  fWickDn = na

// estimated buy/sell from candle direction (same convention as range delta)
bvBar = nz(volume, 0.0)
bBuy = close > open ? bvBar : close < open ? 0.0 : bvBar / 2
bSell = bvBar - bBuy
bDelta = close > open ? bvBar : close < open ? -bvBar : 0.0
if na(pBktId)
    pBktId := bkt
    pBktO  := open
    pBktH  := high
    pBktL  := low
    pBktC  := close
    pBktB  := bBuy
    pBktS  := bSell
    pBktDx := bDelta
    pBktDn := bDelta
else if bkt != pBktId
    array.push(pC, pBktO)
    array.push(pC, pBktH)
    array.push(pC, pBktL)
    array.push(pC, pBktC)
    array.push(pCB, pBktId)
    array.push(pV, pBktB)
    array.push(pV, pBktS)
    array.push(pV, pBktDx)
    array.push(pV, pBktDn)
    while array.size(pCB) > i_pprev + 1
        array.remove(pCB, 0)
        array.remove(pC, 0)
        array.remove(pC, 0)
        array.remove(pC, 0)
        array.remove(pC, 0)
        array.remove(pV, 0)
        array.remove(pV, 0)
        array.remove(pV, 0)
        array.remove(pV, 0)
    // create objects for the just-closed candle (newest closed = index 0)
    if i_panel
        nC2 = array.size(pCB)
        if nC2 > 0
            sw = 6
            ld = i_htgap
            gw = 3
            st = sw + gw
            o2  = array.get(pC, (nC2 - 1) * 4)
            h2  = array.get(pC, (nC2 - 1) * 4 + 1)
            l2  = array.get(pC, (nC2 - 1) * 4 + 2)
            c2  = array.get(pC, (nC2 - 1) * 4 + 3)
            lx2 = bar_index + ld + (i_pprev - 1) * st
            rx2 = lx2 + sw
            wx2 = lx2 + int(sw / 2)
            up2 = c2 >= o2
            bclr2 = up2 ? i_pup : i_pdn
            wclr2 = up2 ? color.new(i_pup, 45) : color.new(i_pdn, 45)
            bTop2 = math.max(o2, c2)
            bBot2 = math.min(o2, c2)
            array.push(pBoxes, box.new(lx2, bTop2, rx2, bBot2, xloc = xloc.bar_index, border_color = bclr2, bgcolor = color.new(bclr2, i_pfill), border_width = 1))
            if h2 > bTop2
                array.push(pWicks, line.new(wx2, h2, wx2, bTop2, xloc = xloc.bar_index, color = wclr2, width = 1))
            else
                array.push(pWicks, line.new(wx2, h2, wx2, bTop2, xloc = xloc.bar_index, color = wclr2, width = 1))
            if bBot2 > l2
                array.push(pWicks, line.new(wx2, bBot2, wx2, l2, xloc = xloc.bar_index, color = wclr2, width = 1))
            else
                array.push(pWicks, line.new(wx2, bBot2, wx2, l2, xloc = xloc.bar_index, color = wclr2, width = 1))
    pBktId := bkt
    pBktO  := open
    pBktH  := high
    pBktL  := low
    pBktC  := close
    pBktB  := bBuy
    pBktS  := bSell
    pBktDx := bDelta
    pBktDn := bDelta
else
    pBktH := math.max(pBktH, high)
    pBktL := math.min(pBktL, low)
    pBktC := close
    pBktB := pBktB + bBuy
    pBktS := pBktS + bSell
    pBktDx := math.max(pBktDx, bDelta)
    pBktDn := math.min(pBktDn, bDelta)

//===== LTF (lower timeframe) candle overlay =====
// Same NY-anchored minute grid as HTF, but stepped by i_ltf minutes, so LTF
// candles align exactly with the HTF candle boundaries. Drawn as a compact
// cluster right of the HTF candles (current + previous i_ltprev).
// Horizontal shift reserved for the candle-1 VP histogram band, in chart bars.
// Same band width expressed in chart bars for the bar_index-anchored overlay
// (immune to hidden halts/session gaps, unlike millisecond time offsets).
vpBars = i_vph ? math.max(1, int(math.round(i_vphw * 60.0 / timeframe.in_seconds()))) : 0
bktMinL = int(i_ltf)
bktSecL = bktMinL * 60000
bStartMinL = int((((nMM - aMin) + 1440) % 1440) / bktMinL) * bktMinL + aMin
if bStartMinL > nMM
    bStartMinL -= 1440
bktL = nyMo + bStartMinL * 60000

var int   lFId = na
var float lFO  = na
var float lFH  = na
var float lFL  = na
var float lFC  = na
var float lFB  = na
var float lFS  = na
var float lFDx = na
var float lFDn = na
var array<float> lC  = array.new_float()
var array<float> lVol = array.new_float()
var array<int>   lCB = array.new_int()
var array<box>   lBoxes = array.new_box()
var array<line>  lWicks = array.new_line()
var box   lfBox    = na
var line  lfWickUp = na
var line  lfWickDn = na

// candle-1 volume-profile persistent objects (rebuilt on candle change, moved each bar)
var int         vpCandle = na
var array<box>  vpBoxes  = array.new_box()
var array<int>  vpW      = array.new_int()
var label       vpLpoc   = na
var label       vpLvah   = na
var label       vpLval   = na
var int         vpWpoc   = 0
var int         vpWvah   = 0
var int         vpWval   = 0

if na(lFId)
    lFId := bktL
    lFO  := open
    lFH  := high
    lFL  := low
    lFC  := close
    lFB  := bBuy
    lFS  := bSell
    lFDx := bDelta
    lFDn := bDelta
else if bktL != lFId
    array.push(lC, lFO)
    array.push(lC, lFH)
    array.push(lC, lFL)
    array.push(lC, lFC)
    array.push(lCB, lFId)
    array.push(lVol, lFB)
    array.push(lVol, lFS)
    array.push(lVol, lFDx)
    array.push(lVol, lFDn)
    while array.size(lCB) > i_ltprev
        array.remove(lCB, 0)
        array.remove(lC, 0)
        array.remove(lC, 0)
        array.remove(lC, 0)
        array.remove(lC, 0)
        array.remove(lVol, 0)
        array.remove(lVol, 0)
        array.remove(lVol, 0)
        array.remove(lVol, 0)
    if i_panel and i_lpanel and i_ltprev >= 1
        nL2 = array.size(lCB)
        if nL2 > 0
            lO2 = array.get(lC, (nL2 - 1) * 4)
            lH2 = array.get(lC, (nL2 - 1) * 4 + 1)
            lL2 = array.get(lC, (nL2 - 1) * 4 + 2)
            lC2 = array.get(lC, (nL2 - 1) * 4 + 3)
            lsw = 6
            lgap = 3
            lstep = lsw + lgap
            lk2 = i_pprev + 1 + i_ltgap + i_ltprev - 1
            lx2 = bar_index + vpBars + i_htgap + lk2 * lstep
            rx2 = lx2 + lsw
            wx2 = lx2 + int(lsw / 2)
            lu2 = lC2 >= lO2
            lb2 = lu2 ? i_pup : i_pdn
            lw2 = lu2 ? color.new(i_pup, 45) : color.new(i_pdn, 45)
            ltp2 = math.max(lO2, lC2)
            lbt2 = math.min(lO2, lC2)
            array.push(lBoxes, box.new(lx2, ltp2, rx2, lbt2, xloc = xloc.bar_index, border_color = lb2, bgcolor = color.new(lb2, i_pfill), border_width = 1))
            array.push(lWicks, line.new(wx2, lH2, wx2, ltp2, xloc = xloc.bar_index, color = lw2, width = 1))
            array.push(lWicks, line.new(wx2, lbt2, wx2, lL2, xloc = xloc.bar_index, color = lw2, width = 1))
    lFId := bktL
    lFO  := open
    lFH  := high
    lFL  := low
    lFC  := close
    lFB  := bBuy
    lFS  := bSell
    lFDx := bDelta
    lFDn := bDelta
else
    lFH := math.max(lFH, high)
    lFL := math.min(lFL, low)
    lFC := close
    lFB := lFB + bBuy
    lFS := lFS + bSell
    lFDx := math.max(lFDx, bDelta)
    lFDn := math.min(lFDn, bDelta)

// shared countdown values (used by the panel label and the info table)
nyMin = hour(timenow, "America/New_York") * 60 + minute(timenow, "America/New_York")
nySec = hour(timenow, "America/New_York") * 3600 + minute(timenow, "America/New_York") * 60 + second(timenow, "America/New_York")
r1S = rh1 * 60 + rm1
r2S = rh2 * 60 + rm2
r3S = rh3 * 60 + rm3
ns1 = r1S > nyMin ? r1S : r1S + 1440
ns2 = r2S > nyMin ? r2S : r2S + 1440
ns3 = r3S > nyMin ? r3S : r3S + 1440
nextS = math.min(ns1, math.min(ns2, ns3))
nextN = nextS == ns1 ? "R1" : nextS == ns2 ? "R2" : "R3"
curN = ""
curE = 0
if nyMin >= r1S and nyMin < r1S + i_r1m
    curN := "R1"
    curE := r1S + i_r1m
else if nyMin >= r2S and nyMin < r2S + i_r2m
    curN := "R2"
    curE := r2S + i_r2m
else if nyMin >= r3S and nyMin < r3S + i_r3m
    curN := "R3"
    curE := r3S + i_r3m
remHtf  = (pBktId + bktSec - timenow) / 1000
remLtf  = (lFId + bktSecL - timenow) / 1000
remNext = nextS * 60 - nySec
remClose = curE * 60 - nySec

if i_panel
    nC = array.size(pCB)
    slotW = 6
    lead = i_htgap
    gapW = 3
    stepW = slotW + gapW
    baseL = i_pprev + 1 + i_ltgap

    // --- forming candle (j=0): always update in-place ---
    // Placed right of the candle-1 VP band so the histogram fans out to the right.
    c1R = bar_index + lead + (i_pprev - 1) * stepW + slotW
    lx0 = c1R + vpBars + 2
    rx0 = lx0 + slotW
    wx0 = lx0 + int(slotW / 2)
    up0 = pBktC >= pBktO
    bclr0 = up0 ? i_pup : i_pdn
    wclr0 = up0 ? color.new(i_pup, 45) : color.new(i_pdn, 45)
    bTop0 = math.max(pBktO, pBktC)
    bBot0 = math.min(pBktO, pBktC)

    if na(fWickUp)
        fWickUp := line.new(wx0, pBktH, wx0, bTop0, xloc = xloc.bar_index, color = wclr0, width = 1)
    else
        line.set_xy1(fWickUp, wx0, pBktH)
        line.set_xy2(fWickUp, wx0, bTop0)
        line.set_color(fWickUp, wclr0)
    if na(fWickDn)
        fWickDn := line.new(wx0, bBot0, wx0, pBktL, xloc = xloc.bar_index, color = wclr0, width = 1)
    else
        line.set_xy1(fWickDn, wx0, bBot0)
        line.set_xy2(fWickDn, wx0, pBktL)
        line.set_color(fWickDn, wclr0)
    if na(fBox)
        fBox := box.new(lx0, bTop0, rx0, bBot0, xloc = xloc.bar_index, border_color = bclr0, bgcolor = color.new(bclr0, i_pfill), border_width = 1)
    else
        box.set_left(fBox, lx0)
        box.set_top(fBox, bTop0)
        box.set_right(fBox, rx0)
        box.set_bottom(fBox, bBot0)
        box.set_border_color(fBox, bclr0)
        box.set_bgcolor(fBox, color.new(bclr0, i_pfill))

    // forming delta label removed - volume/delta values now shown in the info table

    // forming countdown label removed - countdown values now shown in the info table

    // --- closed candles: create once on rollover, update positions only ---
    while array.size(pBoxes) > i_pprev
        box.delete(array.shift(pBoxes))
        line.delete(array.shift(pWicks))
        line.delete(array.shift(pWicks))
    for j = 1 to i_pprev
        idx = nC - j
        if idx >= 0
            base = idx * 4
            o  = array.get(pC, base)
            h  = array.get(pC, base + 1)
            l  = array.get(pC, base + 2)
            c  = array.get(pC, base + 3)
            lx = bar_index + lead + (i_pprev - j) * stepW
            rx = lx + slotW
            wx = lx + int(slotW / 2)
            up = c >= o
            bclr = up ? i_pup : i_pdn
            wclr = up ? color.new(i_pup, 45) : color.new(i_pdn, 45)
            bTop = math.max(o, c)
            bBot = math.min(o, c)
            ci = array.size(pBoxes) - j
            if ci >= 0
                // update existing
                box.set_left(array.get(pBoxes, ci), lx)
                box.set_top(array.get(pBoxes, ci), bTop)
                box.set_right(array.get(pBoxes, ci), rx)
                box.set_bottom(array.get(pBoxes, ci), bBot)
                box.set_border_color(array.get(pBoxes, ci), bclr)
                box.set_bgcolor(array.get(pBoxes, ci), color.new(bclr, i_pfill))
                // wicks: update 2 lines per candle
                wu = ci * 2
                wd = ci * 2 + 1
                if wu < array.size(pWicks) and wd < array.size(pWicks)
                    line.set_xy1(array.get(pWicks, wu), wx, h)
                    line.set_xy2(array.get(pWicks, wu), wx, bTop)
                    line.set_color(array.get(pWicks, wu), wclr)
                    line.set_xy1(array.get(pWicks, wd), wx, bBot)
                    line.set_xy2(array.get(pWicks, wd), wx, l)
                    line.set_color(array.get(pWicks, wd), wclr)

    // --- candle-1 volume profile: rebuild when candle[1] changes, move every bar ---
    c1Id = nC > 0 ? array.get(pCB, nC - 1) : na
    if i_vph and not na(c1Id)
        if na(vpCandle) or vpCandle != c1Id
            while array.size(vpBoxes) > 0
                box.delete(array.shift(vpBoxes))
            array.clear(vpW)
            if not na(vpLpoc)
                label.delete(vpLpoc)
                vpLpoc := na
            if not na(vpLvah)
                label.delete(vpLvah)
                vpLvah := na
            if not na(vpLval)
                label.delete(vpLval)
                vpLval := na
            vpWpoc := 0
            vpWvah := 0
            vpWval := 0
            vpCandle := c1Id
            lvlsP = math.max(2, i_vplvls)
            [vVols, vLo, vStp, vMx, vPoc, vVaHi, vVaLo] = f_candleProfile(c1Id, c1Id + bktSec, lvlsP)
            if vPoc >= 0 and not na(vLo) and not na(vStp) and vStp > 0 and not na(vMx) and vMx > 0
                bwP = vpBars
                for q = 0 to lvlsP - 1
                    vqP = array.get(vVols, q)
                    if vqP > 0
                        wqP = int(math.max(1, math.round(bwP * vqP / vMx)))
                        bloP = vLo + q * vStp
                        bhiP = vLo + (q + 1) * vStp
                        bclrP = q == vPoc
                             ? color.new(tVpPocEff, 25)
                             : q == vVaLo
                             ? color.new(tVpValEff, 25)
                             : q == vVaHi
                             ? color.new(tVpVahEff, 25)
                             : (q >= vVaLo and q <= vVaHi) ? color.new(tVpVaEff, 45) : color.new(tVpBinEff, 35)
                        array.push(vpBoxes, box.new(bar_index, bhiP, bar_index, bloP, xloc = xloc.bar_index, border_color = bclrP, bgcolor = bclrP, border_width = 1))
                        array.push(vpW, wqP)
                        if q == vPoc
                            vpLpoc := label.new(bar_index, (bloP + bhiP) / 2 - vStp * 0.3, "POC", xloc = xloc.bar_index, color = na,
                                 textcolor = f_txtC(tVpPocEff), style = label.style_none, size = size.small)
                            vpWpoc := wqP
                        if q == vVaLo and vVaLo != vPoc
                            vpLval := label.new(bar_index, (bloP + bhiP) / 2 - vStp * 0.3, "VAL", xloc = xloc.bar_index, color = na,
                                 textcolor = f_txtC(tVpValEff), style = label.style_none, size = size.small)
                            vpWval := wqP
                        if q == vVaHi and vVaHi != vPoc
                            vpLvah := label.new(bar_index, (bloP + bhiP) / 2 - vStp * 0.3, "VAH", xloc = xloc.bar_index, color = na,
                                 textcolor = f_txtC(tVpVahEff), style = label.style_none, size = size.small)
                            vpWvah := wqP
        if array.size(vpBoxes) > 0
            HL = bar_index + lead + (i_pprev - 1) * stepW + slotW + 1
            for bI = 0 to array.size(vpBoxes) - 1
                box.set_left(array.get(vpBoxes, bI), HL)
                box.set_right(array.get(vpBoxes, bI), HL + array.get(vpW, bI))
            if vpWpoc > 0
                label.set_x(vpLpoc, int(HL + vpWpoc / 2))
            if vpWval > 0
                label.set_x(vpLval, int(HL + vpWval / 2))
            if vpWvah > 0
                label.set_x(vpLvah, int(HL + vpWvah / 2))
    else
        while array.size(vpBoxes) > 0
            box.delete(array.shift(vpBoxes))
        array.clear(vpW)
        if not na(vpLpoc)
            label.delete(vpLpoc)
            vpLpoc := na
        if not na(vpLvah)
            label.delete(vpLvah)
            vpLvah := na
        if not na(vpLval)
            label.delete(vpLval)
            vpLval := na
        vpCandle := na

    // --- LTF cluster (persistent objects, repositioned every bar) ---
    if i_lpanel
        // forming / current LTF candle (rightmost of the LTF cluster)
        lxL0 = bar_index + vpBars + lead + (baseL + i_ltprev) * stepW
        rxL0 = lxL0 + slotW
        wxL0 = lxL0 + int(slotW / 2)
        lup0 = lFC >= lFO
        lb0 = lup0 ? i_pup : i_pdn
        lw0 = lup0 ? color.new(i_pup, 45) : color.new(i_pdn, 45)
        ltp0 = math.max(lFO, lFC)
        lbt0 = math.min(lFO, lFC)
        if na(lfBox)
            lfBox := box.new(lxL0, ltp0, rxL0, lbt0, xloc = xloc.bar_index, border_color = lb0, bgcolor = color.new(lb0, i_pfill), border_width = 1)
            lfWickUp := line.new(wxL0, lFH, wxL0, ltp0, xloc = xloc.bar_index, color = lw0, width = 1)
            lfWickDn := line.new(wxL0, lbt0, wxL0, lFL, xloc = xloc.bar_index, color = lw0, width = 1)
        else
            box.set_left(lfBox, lxL0)
            box.set_top(lfBox, ltp0)
            box.set_right(lfBox, rxL0)
            box.set_bottom(lfBox, lbt0)
            box.set_border_color(lfBox, lb0)
            box.set_bgcolor(lfBox, color.new(lb0, i_pfill))
            line.set_xy1(lfWickUp, wxL0, lFH)
            line.set_xy2(lfWickUp, wxL0, ltp0)
            line.set_color(lfWickUp, lw0)
            line.set_xy1(lfWickDn, wxL0, lbt0)
            line.set_xy2(lfWickDn, wxL0, lFL)
            line.set_color(lfWickDn, lw0)
        // previous LTF candles
        nL = array.size(lCB)
        while array.size(lBoxes) > i_ltprev
            box.delete(array.shift(lBoxes))
            line.delete(array.shift(lWicks))
            line.delete(array.shift(lWicks))
        for jL = 1 to i_ltprev
            iL = nL - jL
            if iL >= 0
                bL = iL * 4
                oL = array.get(lC, bL)
                hL = array.get(lC, bL + 1)
                lL = array.get(lC, bL + 2)
                cL = array.get(lC, bL + 3)
                lk3 = baseL + i_ltprev - jL
                lxL = bar_index + vpBars + lead + lk3 * stepW
                rxL = lxL + slotW
                wxL = lxL + int(slotW / 2)
                lupC = cL >= oL
                lbC = lupC ? i_pup : i_pdn
                lwC = lupC ? color.new(i_pup, 45) : color.new(i_pdn, 45)
                ltpC = math.max(oL, cL)
                lbtC = math.min(oL, cL)
                ciL = array.size(lBoxes) - jL
                if ciL >= 0
                    box.set_left(array.get(lBoxes, ciL), lxL)
                    box.set_top(array.get(lBoxes, ciL), ltpC)
                    box.set_right(array.get(lBoxes, ciL), rxL)
                    box.set_bottom(array.get(lBoxes, ciL), lbtC)
                    box.set_border_color(array.get(lBoxes, ciL), lbC)
                    box.set_bgcolor(array.get(lBoxes, ciL), color.new(lbC, i_pfill))
                    wuL = ciL * 2
                    wdL = ciL * 2 + 1
                    if wuL < array.size(lWicks) and wdL < array.size(lWicks)
                        line.set_xy1(array.get(lWicks, wuL), wxL, hL)
                        line.set_xy2(array.get(lWicks, wuL), wxL, ltpC)
                        line.set_color(array.get(lWicks, wuL), lwC)
                        line.set_xy1(array.get(lWicks, wdL), wxL, lbtC)
                        line.set_xy2(array.get(lWicks, wdL), wxL, lL)
                        line.set_color(array.get(lWicks, wdL), lwC)
    else
        if not na(lfBox)
            box.delete(lfBox)
            lfBox := na
        if not na(lfWickUp)
            line.delete(lfWickUp)
            lfWickUp := na
        if not na(lfWickDn)
            line.delete(lfWickDn)
            lfWickDn := na
        while array.size(lBoxes) > 0
            box.delete(array.shift(lBoxes))
        while array.size(lWicks) > 0
            line.delete(array.shift(lWicks))

else
    if not na(fBox)
        box.delete(fBox)
        fBox := na
    if not na(fWickUp)
        line.delete(fWickUp)
        fWickUp := na
    if not na(fWickDn)
        line.delete(fWickDn)
        fWickDn := na
    while array.size(pBoxes) > 0
        box.delete(array.shift(pBoxes))
    while array.size(pWicks) > 0
        line.delete(array.shift(pWicks))
    if not na(lfBox)
        box.delete(lfBox)
        lfBox := na
    if not na(lfWickUp)
        line.delete(lfWickUp)
        lfWickUp := na
    if not na(lfWickDn)
        line.delete(lfWickDn)
        lfWickDn := na
    while array.size(lBoxes) > 0
        box.delete(array.shift(lBoxes))
    while array.size(lWicks) > 0
        line.delete(array.shift(lWicks))
    while array.size(vpBoxes) > 0
        box.delete(array.shift(vpBoxes))
    array.clear(vpW)
    if not na(vpLpoc)
        label.delete(vpLpoc)
        vpLpoc := na
    if not na(vpLvah)
        label.delete(vpLvah)
        vpLvah := na
    if not na(vpLval)
        label.delete(vpLval)
        vpLval := na
    vpCandle := na

//===== CVD (Cumulative Volume Delta, same engine as TV's built-in) =====
// Overlay script, so CVD is shown as values in its own panel (bottom-left)
// instead of a separate-pane plot. Anchor 1W + Time aggregation by default.
cvdUseTicks = i_cvdAgg == "1 tick"
cvdLowerTf = switch
    cvdUseTicks          => "1T"
    i_cvdCustom          => i_cvdTf
    timeframe.isseconds  => "1S"
    timeframe.isintraday => "1"
    timeframe.isdaily    => "5"
    => "60"
[cvdOpen, cvdHigh, cvdLow, cvdLast] = ta.requestVolumeDelta(cvdLowerTf, i_cvdAnchor)

// Swing pivots hoisted to globals: ta.pivot* depends on bar history and must
// execute on every bar for consistent results, so the engine and the markers
// below share these instead of calling inside conditional expressions.
swingHi = ta.pivothigh(high, i_cvdDivL, i_cvdDivR)
swingLo = ta.pivotlow(low, i_cvdDivL, i_cvdDivR)

//===== Price-CVD divergence (regular + hidden, drawn on the price chart) =====
// Each confirmed price swing is paired with CVD's extreme over that swing's
// own footprint (highest CVD high / lowest CVD low across the pivot span),
// bar_index-anchored. Same-bar pairing by construction: no stale swings, no
// future data beyond pivot confirmation. Bullish: price lower-low + CVD
// higher-low. Bearish: price higher-high + CVD lower-high. Hidden variants
// likewise. Near-term pairs only, once per swing; reset on CVD anchor
// rollover. Latest signal latches for the CVD panel.
var float prevPhP = na
var int   prevPhB = na
var float lastPhP = na
var int   lastPhB = na
var float prevCvdH = na
var float lastCvdH = na
var int   lastBearB = na
var float prevPlP = na
var int   prevPlB = na
var float lastPlP = na
var int   lastPlB = na
var float prevCvdL = na
var float lastCvdL = na
var int   lastBullB = na
var string cvdDivState = "—"
cvdAnchorChg = ta.change(time(i_cvdAnchor))
cvdAnchorRollover = not na(cvdAnchorChg) and cvdAnchorChg != 0
// CVD footprint extremes (must run every bar like the pivots).
cvdFootHi = ta.highest(cvdHigh, i_cvdDivL + i_cvdDivR + 1)
cvdFootLo = ta.lowest(cvdLow, i_cvdDivL + i_cvdDivR + 1)
if i_cvdDiv
    if cvdAnchorRollover
        prevPhP := na
        prevPhB := na
        lastPhP := na
        lastPhB := na
        prevCvdH := na
        lastCvdH := na
        lastBearB := na
        prevPlP := na
        prevPlB := na
        lastPlP := na
        lastPlB := na
        prevCvdL := na
        lastCvdL := na
        lastBullB := na
        cvdDivState := "—"
    if not na(swingHi)
        prevPhP := lastPhP
        prevPhB := lastPhB
        prevCvdH := lastCvdH
        lastPhP := high[i_cvdDivR]
        lastPhB := bar_index[i_cvdDivR]
        lastCvdH := cvdFootHi
    if not na(swingLo)
        prevPlP := lastPlP
        prevPlB := lastPlB
        prevCvdL := lastCvdL
        lastPlP := low[i_cvdDivR]
        lastPlB := bar_index[i_cvdDivR]
        lastCvdL := cvdFootLo
    if not na(lastPhP) and not na(prevPhP) and not na(lastCvdH) and not na(prevCvdH) and (na(lastBearB) or lastPhB != lastBearB) and lastPhB - prevPhB <= i_cvdDivMax and ((i_cvdDivMode != "Hidden" and lastPhP > prevPhP and lastCvdH < prevCvdH) or (i_cvdDivMode != "Regular" and lastPhP < prevPhP and lastCvdH > prevCvdH))
        bearHid = i_cvdDivMode != "Regular" and lastPhP < prevPhP and lastCvdH > prevCvdH
        f_regDivL(line.new(prevPhB, prevPhP, lastPhB, lastPhP, xloc = xloc.bar_index, color = c_dneg, style = bearHid ? line.style_dashed : line.style_solid, width = 2))
        f_regDivT(label.new(lastPhB, lastPhP, "Bear Div", xloc = xloc.bar_index, color = c_dneg, textcolor = f_txtC(c_dneg), style = label.style_label_down, size = size.small))
        cvdDivState := "Bear Div"
        lastBearB := lastPhB
        alert(bearHid ? "Luminar-3: hidden bearish price-CVD divergence" : "Luminar-3: bearish price-CVD divergence", alert.freq_once_per_bar_close)
    if not na(lastPlP) and not na(prevPlP) and not na(lastCvdL) and not na(prevCvdL) and (na(lastBullB) or lastPlB != lastBullB) and lastPlB - prevPlB <= i_cvdDivMax and ((i_cvdDivMode != "Hidden" and lastPlP < prevPlP and lastCvdL > prevCvdL) or (i_cvdDivMode != "Regular" and lastPlP > prevPlP and lastCvdL < prevCvdL))
        bullHid = i_cvdDivMode != "Regular" and lastPlP > prevPlP and lastCvdL < prevCvdL
        f_regDivL(line.new(prevPlB, prevPlP, lastPlB, lastPlP, xloc = xloc.bar_index, color = c_dpos, style = bullHid ? line.style_dashed : line.style_solid, width = 2))
        f_regDivT(label.new(lastPlB, lastPlP, "Bull Div", xloc = xloc.bar_index, color = c_dpos, textcolor = f_txtC(c_dpos), style = label.style_label_up, size = size.small))
        cvdDivState := "Bull Div"
        lastBullB := lastPlB
        alert(bullHid ? "Luminar-3: hidden bullish price-CVD divergence" : "Luminar-3: bullish price-CVD divergence", alert.freq_once_per_bar_close)

// Swing high/low markers: the exact pivots the divergence engine compares,
// shifted back onto the swing bar. Independent toggle.
plotshape(i_cvdPiv and not na(swingHi), title = "Swing High", style = shape.triangledown, location = location.abovebar, color = c_dneg, size = size.tiny, offset = -i_cvdDivR)
plotshape(i_cvdPiv and not na(swingLo), title = "Swing Low", style = shape.triangleup, location = location.belowbar, color = c_dpos, size = size.tiny, offset = -i_cvdDivR)

//===== Info display: volume grid top-right, countdown table bottom-right =====
// Two tables anchored at different corners (the layout Pine supports without any
// overlapping). Volume columns interleave HTF/LTF: HTF cur, LTF cur, HTF 1, LTF 1, ...
htfCols = i_pprev + 1
ltfCols = i_ltprev + 1
vCols = 1 + htfCols + ltfCols
var table tbV = na
var table tbC = na
if i_showTbl
    tTblBgEff  = tDark ? i_tblBg : i_tblBgL
    tTblLbEff  = tDark ? i_tblLb : i_tblLbL
    tTblVlEff  = tDark ? i_tblVl : i_tblVlL
    tTblAccEff = tDark ? i_tblAcc : i_tblAccL
    tTblBg  = color.new(tTblBgEff, 100 - i_tblOp)
    tTblVal = color.new(tTblBgEff, 100 - i_tblOp)
    tTblAcc = color.new(tTblAccEff, 100 - i_tblAOp)
    tTblLin = color.new(tTblAccEff, 10)
    if na(tbV)
        tbV := table.new(position.top_right, vCols, 6, bgcolor = tTblBg, border_width = 1, border_color = tTblLin, frame_width = 1, frame_color = tTblLin)
    if na(tbC)
        tbC := table.new(position.bottom_right, 2, 5, bgcolor = tTblBg, border_width = 1, border_color = tTblLin, frame_width = 1, frame_color = tTblLin)
        table.merge_cells(tbC, 0, 0, 1, 0)
    thN = array.size(pCB)
    tlN = array.size(lCB)
    // volume grid (top-right) - header bar + metrics
    hBase = str.tostring(i_ptf) + "m"
    lBase = str.tostring(i_ltf) + "m"
    table.cell(tbV, 0, 0, "Live", text_color = tTblLbEff, bgcolor = tTblAcc, text_size = size.small)
    for c = 0 to htfCols - 1
        hLab = c == 0 ? hBase : hBase + "-" + str.tostring(c)
        table.cell(tbV, 1 + 2 * c, 0, hLab, text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    for c = 0 to ltfCols - 1
        lLab = c == 0 ? lBase : lBase + "-" + str.tostring(c)
        table.cell(tbV, 2 + 2 * c, 0, lLab, text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    table.cell(tbV, 0, 1, "Volume", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbV, 0, 2, "Buy", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbV, 0, 3, "Sell", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbV, 0, 4, "Delta", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbV, 0, 5, "Hi/Lo", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    // HTF columns (0 = current/forming, c>0 = previous closed)
    for c = 0 to htfCols - 1
        float hb = na
        float hs = na
        float hx = na
        float hn = na
        if c == 0
            hb := pBktB
            hs := pBktS
            hx := pBktDx
            hn := pBktDn
        else
            hix = thN - c
            if hix >= 0
                hbase = hix * 4
                hb := array.get(pV, hbase)
                hs := array.get(pV, hbase + 1)
                hx := array.get(pV, hbase + 2)
                hn := array.get(pV, hbase + 3)
        ddH = na(hb) ? na : hb - hs
        hCol = na(ddH) ? tTblLbEff : ddH >= 0 ? c_dpos : c_dneg
        hxCol = na(hx) ? tTblLbEff : hx >= 0 ? c_dpos : c_dneg
        hcc = 1 + 2 * c
        table.cell(tbV, hcc, 1, na(hb) ? "-" : f_cvol(hb + hs), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, hcc, 2, na(hb) ? "-" : f_cvol(hb), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, hcc, 3, na(hb) ? "-" : f_cvol(hs), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, hcc, 4, na(ddH) ? "-" : (ddH >= 0 ? "+" : "") + f_cvol(ddH), text_color = hCol, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, hcc, 5, na(hx) ? "-" : (hx >= 0 ? "+" : "") + f_cvol(hx) + " / " + (hn >= 0 ? "+" : "") + f_cvol(hn), text_color = hxCol, bgcolor = tTblVal, text_size = size.small)
    // LTF columns
    for c = 0 to ltfCols - 1
        float lb = na
        float ls = na
        float lx = na
        float ln = na
        if c == 0
            lb := lFB
            ls := lFS
            lx := lFDx
            ln := lFDn
        else
            lix = tlN - c
            if lix >= 0
                lbase = lix * 4
                lb := array.get(lVol, lbase)
                ls := array.get(lVol, lbase + 1)
                lx := array.get(lVol, lbase + 2)
                ln := array.get(lVol, lbase + 3)
        ddL = na(lb) ? na : lb - ls
        lCol = na(ddL) ? tTblLbEff : ddL >= 0 ? c_dpos : c_dneg
        lxCol = na(lx) ? tTblLbEff : lx >= 0 ? c_dpos : c_dneg
        cc = 2 + 2 * c
        table.cell(tbV, cc, 1, na(lb) ? "-" : f_cvol(lb + ls), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, cc, 2, na(lb) ? "-" : f_cvol(lb), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, cc, 3, na(lb) ? "-" : f_cvol(ls), text_color = tTblVlEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, cc, 4, na(ddL) ? "-" : (ddL >= 0 ? "+" : "") + f_cvol(ddL), text_color = lCol, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbV, cc, 5, na(lx) ? "-" : (lx >= 0 ? "+" : "") + f_cvol(lx) + " / " + (ln >= 0 ? "+" : "") + f_cvol(ln), text_color = lxCol, bgcolor = tTblVal, text_size = size.small)
    // countdown table (bottom-right): title + key | value rows
    table.cell(tbC, 0, 0, "Countdown", text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    table.cell(tbC, 0, 1, str.tostring(i_ptf) + "m close", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbC, 1, 1, f_cnt(remHtf), text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    table.cell(tbC, 0, 2, str.tostring(i_ltf) + "m close", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbC, 1, 2, f_cnt(remLtf), text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    table.cell(tbC, 0, 3, nextN + " start", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
    table.cell(tbC, 1, 3, f_cnt(remNext), text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    if curN != ""
        table.cell(tbC, 0, 4, curN + " close", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbC, 1, 4, f_cnt(remClose), text_color = tTblVlEff, bgcolor = tTblAcc, text_size = size.small)
    else
        table.cell(tbC, 0, 4, "Range close", text_color = tTblLbEff, bgcolor = tTblVal, text_size = size.small)
        table.cell(tbC, 1, 4, "--:--:--", text_color = tTblLbEff, bgcolor = tTblAcc, text_size = size.small)
else
    if not na(tbV)
        table.delete(tbV)
        tbV := na
    if not na(tbC)
        table.delete(tbC)
        tbC := na

//===== CVD panel (bottom-left): anchor open/high/low/last =====
var table tbD = na
if i_showCvd
    cvdBgEff  = tDark ? i_tblBg : i_tblBgL
    cvdLbEff  = tDark ? i_tblLb : i_tblLbL
    cvdVlEff  = tDark ? i_tblVl : i_tblVlL
    cvdAccEff = tDark ? i_tblAcc : i_tblAccL
    cvdBg  = color.new(cvdBgEff, 100 - i_tblOp)
    cvdAcc = color.new(cvdAccEff, 100 - i_tblAOp)
    cvdLin = color.new(cvdAccEff, 10)
    if na(tbD)
        tbD := table.new(position.bottom_left, 2, 6, bgcolor = cvdBg, border_width = 1, border_color = cvdLin, frame_width = 1, frame_color = cvdLin)
        table.merge_cells(tbD, 0, 0, 1, 0)
    cvdDirUp = not na(cvdLast) and not na(cvdOpen) and cvdLast >= cvdOpen
    cvdLastCol = na(cvdLast) or na(cvdOpen) ? cvdLbEff : cvdDirUp ? c_dpos : c_dneg
    table.cell(tbD, 0, 0, "CVD (" + i_cvdAnchor + ")", text_color = cvdVlEff, bgcolor = cvdAcc, text_size = size.small)
    table.cell(tbD, 0, 1, "Open", text_color = cvdLbEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 1, 1, na(cvdOpen) ? "-" : (cvdOpen >= 0 ? "+" : "") + f_cvol(cvdOpen), text_color = cvdVlEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 0, 2, "High", text_color = cvdLbEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 1, 2, na(cvdHigh) ? "-" : (cvdHigh >= 0 ? "+" : "") + f_cvol(cvdHigh), text_color = cvdVlEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 0, 3, "Low", text_color = cvdLbEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 1, 3, na(cvdLow) ? "-" : (cvdLow >= 0 ? "+" : "") + f_cvol(cvdLow), text_color = cvdVlEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 0, 4, "Last", text_color = cvdLbEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 1, 4, na(cvdLast) ? "-" : (cvdLast >= 0 ? "+" : "") + f_cvol(cvdLast), text_color = cvdLastCol, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 0, 5, "Signal", text_color = cvdLbEff, bgcolor = cvdBg, text_size = size.small)
    table.cell(tbD, 1, 5, cvdDivState, text_color = cvdDivState == "Bear Div" ? c_dneg : cvdDivState == "Bull Div" ? c_dpos : cvdLbEff, bgcolor = cvdBg, text_size = size.small)
else
    if not na(tbD)
        table.delete(tbD)
        tbD := na
